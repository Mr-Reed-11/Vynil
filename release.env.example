# Config de conexão embutida no APK em cada release (copie para release.env).
# release.env é ignorado pelo git.

# URL do backend que o APK vai usar por padrão (túnel, IP da LAN, domínio...).
# Se vazio, o app cai no padrão (localhost) — e aí você aponta pela tela de
# Configurações do app.
API_BASE_URL=https://sound-root-indication-enterprises.trycloudflare.com

# API key embutida. Se vazio, o release.sh usa o APP_API_KEY do backend/.env.
API_KEY=
