# Porta HTTP do servidor
PORT=3000

# Onde as musicas ficam armazenadas.
# Local: ./storage | Docker: /data (volume)
STORAGE_DIR=./storage

# Quantos downloads simultaneos (1-2 e o recomendado)
DOWNLOAD_CONCURRENCY=1

# Duracao maxima aceita, em segundos (0 = sem limite)
MAX_DURATION_SECONDS=0

# Caminho dos binarios (deixe vazio para usar o PATH)
YTDLP_PATH=
FFMPEG_PATH=

# Opcional: arquivo de cookies do navegador para contornar o anti-bot do YouTube
# (formato Netscape, exportado por extensao tipo "Get cookies.txt").
YTDLP_COOKIES_FILE=

# URL publica usada para montar as URLs de stream/cover nas respostas.
# Ex.: http://192.168.0.10:3000  (vazio = URLs relativas)
PUBLIC_BASE_URL=

# Protecao opcional: se preenchido, exige o header x-api-key
# (ou ?api_key=... para players que nao enviam headers)
APP_API_KEY=
