# Porta HTTP do servidor
PORT=3000

# Onde as musicas ficam armazenadas.
# Local: ./storage | Docker: /data (volume)
STORAGE_DIR=./storage

# Quantos downloads simultaneos (1-2 e o recomendado)
DOWNLOAD_CONCURRENCY=1

# Duracao maxima aceita, em segundos (0 = sem limite)
MAX_DURATION_SECONDS=0

# Maximo de itens baixados de uma playlist por vez
MAX_PLAYLIST_ITEMS=100

# Caminho dos binarios (deixe vazio para usar o PATH)
YTDLP_PATH=
FFMPEG_PATH=

# Opcional: arquivo de cookies do navegador para contornar o anti-bot do YouTube
# (formato Netscape, exportado por extensao tipo "Get cookies.txt").
YTDLP_COOKIES_FILE=

# URL publica usada para montar as URLs de stream/cover nas respostas.
# Ex.: http://192.168.0.10:3000  (vazio = URLs relativas)
PUBLIC_BASE_URL=

# Multi-usuario (JWT): cada usuario tem sua propria biblioteca.
# O cadastro exige uma chave de convite (INVITE_KEY). Se INVITE_KEY/JWT_SECRET
# ficarem vazios, usam o APP_API_KEY abaixo como padrao.
APP_API_KEY=
# Segredo para assinar os tokens JWT (deixe vazio = usa APP_API_KEY).
JWT_SECRET=
# Chave de convite exigida no cadastro (deixe vazio = usa APP_API_KEY).
INVITE_KEY=
# Validade do token em segundos (padrao 30 dias).
JWT_TTL_SECONDS=2592000

# --- Atualizacao in-app (APK sideloaded) ---
# Versao mais recente publicada; o app compara APP_LATEST_BUILD com o seu.
APP_LATEST_VERSION=1.0.0
APP_LATEST_BUILD=1
# APK servido em GET /api/app/apk (caminho DENTRO do container).
APP_APK_FILE=/data/releases/vynil.apk
# Alternativa: URL externa do APK (tem prioridade sobre APP_APK_FILE).
APP_APK_URL=
# Novidades mostradas no aviso de atualizacao.
APP_RELEASE_NOTES=
# true para forcar a atualizacao.
APP_UPDATE_MANDATORY=false
